# Harmonia backend configuration.
#
# DATABASE_URL is the only variable the backend reads at runtime
# (backend/models/database.py). Set it to a SQLite path for a local,
# zero-setup database, or to a Postgres URL to use Postgres instead.
#
# Local SQLite (default target for the local-first rebuild):
DATABASE_URL=sqlite:///./harmonia.db
#
# Postgres example:
# DATABASE_URL=postgresql://user:password@localhost:5432/harmonia
