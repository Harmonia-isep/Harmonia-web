# Harmonia backend configuration.

# DATABASE_URL: where the backend stores data. Use a SQLite path for a local,
# zero-setup database, or a Postgres URL to use Postgres instead.
#
# Local SQLite (default target for the local-first rebuild):
DATABASE_URL=sqlite:///./harmonia.db
#
# Postgres example:
# DATABASE_URL=postgresql://user:password@localhost:5432/harmonia

# CORS_ORIGINS: comma-separated list of browser origins allowed to call the API.
# Only needed when the frontend is served from a different origin than the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
